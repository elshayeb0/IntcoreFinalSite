{
  "name": "intcore-final",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.js",
    "tw:watch": "tailwindcss -c config/tailwind.config.js -i src/css/style.css -o public/style.css --watch",
    "build:css": "tailwindcss -c config/tailwind.config.js -i src/css/style.css -o public/style.css --minify",
    "build": "npm run build:css && vite build --config config/vite.config.js",
    "preview": "vite preview --config config/vite.config.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "intl-tel-input": "^18.2.1"
  }
}
